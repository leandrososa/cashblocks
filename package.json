{
  "name": "cashblocks",
  "version": "0.1.0",
  "description": "Simulator-first TypeScript runtime for testable ATM flows, pluggable adapters, and replayable journals.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "engines": {
    "bun": ">=1.3.10",
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandrososa/cashblocks.git"
  },
  "homepage": "https://github.com/leandrososa/cashblocks#readme",
  "bugs": {
    "url": "https://github.com/leandrososa/cashblocks/issues"
  },
  "keywords": [
    "atm",
    "financial-terminals",
    "iso8583",
    "simulation",
    "typescript"
  ],
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "bun run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && node scripts/run-tests.mjs",
    "check": "bun run typecheck && bun run test",
    "replay": "bun packages/journal-replay/src/cli.ts",
    "certify": "bun packages/certification-harness/src/cli.ts",
    "package:native": "bun run build && bun apps/native-terminal/src/package.ts",
    "dev": "bun run build && node dist/apps/terminal-shell/src/dev-server.js",
    "customer": "bun run build && node dist/apps/customer-terminal/src/dev-server.js",
    "demo": "bun run build && CASHBLOCKS_JOURNAL_PATH=./data/demo.journal.jsonl node dist/apps/terminal-shell/src/dev-server.js",
    "example:atm": "bun run build && node dist/examples/atm-basic/src/run.js"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "typescript": "^5.8.3"
  }
}
